@CoffeeExpress_HostAddress = http://localhost:5235

GET {{CoffeeExpress_HostAddress}}/weatherforecast/
Accept: application/json

###TODOS
GET {{CoffeeExpress_HostAddress}}/api/coffees/
Accept: application/json

###UNO
GET {{CoffeeExpress_HostAddress}}/api/coffees/2
Accept: application/json

###AGREGAR
POST {{CoffeeExpress_HostAddress}}/api/coffees/
Content-Type: application/json
Accept: application/json
    {
        "Name": "Café México",
        "Description": "Molido perfecto para preparaciones intensas con toques afrutados, originario de México.",
        "Type": "Cápsula",
        "Price": 7000.00,
        "Origin": "México",
        "Roast": "Dark",
        "SalesCount": 0,
        "Url": "Images/cafe-mexico.webp"
    }

###ACTUALZIAR
PUT {{CoffeeExpress_HostAddress}}/api/coffees/2
Content-Type: application/json
Accept: application/json

{
    "IdCoffee": 2,
    "Name": "Café Blue Mountainn",
    "Description": "Molido perfecto para preparaciones intensas con toques afrutados.",
    "Type": "Molido",
    "Price": 7000.00,
    "Origin": "Jamaica",
    "Roast": "Dark",
    "SalesCount": 0
}

###ELIMIMINAR
DELETE {{CoffeeExpress_HostAddress}}/api/coffees/7
Content-Type: application/json
Accept: application/json

###REGISTRO DE USUARIO
POST {{CoffeeExpress_HostAddress}}/api/auth/register
Content-Type: application/json
Accept: application/json
{
    "Name": "Marie Doe",
    "Email": "marie_doe@example.com",
    "Password": "TheStrokes123"
}

###LOGIN USUARIO
POST {{CoffeeExpress_HostAddress}}/api/auth/login
Content-Type: application/json
Accept: application/json
{
    "Email": "marie_doe@example.com",
    "Password": "TheStrokes123"
}


